generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ANALISTA_SEGURANCA
  GESTOR_CLIENTE
  COLABORADOR
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationSize {
  MICRO
  PEQUENA
  MEDIA
  GRANDE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  ASSIGN
  STATUS_CHANGE
}

enum IntegrationStatus {
  NOT_CONFIGURED
  DEMO
  ACTIVE
  ERROR
  DISABLED
}

enum AssetType {
  HARDWARE
  SOFTWARE
  DATA
  SERVICE
  NETWORK
  PEOPLE
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  LOST
  RETIRED
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssessmentStatus {
  RASCUNHO
  EM_ANDAMENTO
  CONCLUIDA
}

enum RiskLevel {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

enum RiskStatus {
  ABERTO
  EM_TRATAMENTO
  ACEITE
  MITIGADO
  FECHADO
}

enum TreatmentTaskStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BackupFrequency {
  DIARIA
  SEMANAL
  MENSAL
  OUTRA
}

enum BackupJobStatus {
  SUCESSO
  FALHA
  AVISO
  DESCONHECIDO
}

enum VerificationResult {
  SUCESSO
  FALHA
}

enum TicketStatus {
  ABERTO
  EM_ANALISE
  EM_ANDAMENTO
  AGUARDA_CLIENTE
  RESOLVIDO
  FECHADO
}

enum TicketCategory {
  SUPORTE
  INCIDENTE
  SOLICITACAO
  OUTRO
}

enum TicketEventType {
  STATUS_CHANGE
  ATRIBUICAO
  NOTA
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentType {
  PHISHING
  MALWARE
  RANSOMWARE
  CONTA_COMPROMETIDA
  PERDA_ROUBO_EQUIPAMENTO
  ACESSO_INDEVIDO
  FRAUDE
  INDISPONIBILIDADE
  OUTRO
}

enum IncidentStatus {
  REPORTADO
  EM_ANALISE
  CONTIDO
  ERRADICADO
  RECUPERADO
  ENCERRADO
}

enum IncidentEventType {
  STATUS_CHANGE
  ACAO
  NOTA
}

enum PhishingChannel {
  EMAIL
  WHATSAPP
  SMS
  OUTRO
}

enum PhishingClassification {
  BAIXA
  MEDIA
  ALTA
}

enum PhishingReportStatus {
  NOVO
  EM_ANALISE
  CONVERTIDO_TICKET
  CONVERTIDO_INCIDENTE
  FALSO_POSITIVO
  ENCERRADO
}

enum ScoreCategory {
  CRITICO
  EM_RISCO
  ACEITAVEL
  BOM
}

enum PhishingCampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

model User {
  id                     String                   @id @default(cuid())
  name                   String
  email                  String                   @unique
  passwordHash           String
  emailVerified          DateTime?
  isActive               Boolean                  @default(true)
  memberships            OrganizationMembership[]
  auditLogs              AuditLog[]               @relation("AuditActor")
  assessmentsOwned       RiskAssessment[]         @relation("AssessmentOwner")
  risksOwned             Risk[]                   @relation("RiskOwner")
  treatmentTasksAssigned RiskTreatmentTask[]      @relation("TreatmentTaskAssignee")
  taskComments           TaskComment[]
  ticketsCreated         Ticket[]                 @relation("TicketCreator")
  ticketsAssigned        Ticket[]                 @relation("TicketAssignee")
  ticketComments         TicketComment[]
  ticketEvents           TicketEvent[]
  incidentsResponsible   Incident[]               @relation("IncidentResponsible")
  incidentEvents         IncidentTimelineEvent[]
  phishingReports        PhishingReport[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([isActive])
}

model Organization {
  id                String                   @id @default(cuid())
  name              String
  slug              String                   @unique
  nif               String?
  sector            String?
  dimensao          OrganizationSize?
  city              String?
  provincia         String?
  contactoNome      String?
  contactoEmail     String?
  contactoTelefone  String?
  planoId           String?
  plano             SubscriptionPlan?        @relation(fields: [planoId], references: [id], onDelete: SetNull)
  status            OrganizationStatus       @default(ACTIVE)
  memberships       OrganizationMembership[]
  auditLogs         AuditLog[]
  integrations      Integration[]
  assets            Asset[]
  riskAssessments   RiskAssessment[]
  risks             Risk[]
  treatmentTasks    RiskTreatmentTask[]
  backupJobs        BackupJob[]
  tickets           Ticket[]
  incidents         Incident[]
  phishingCampaigns PhishingCampaign[]
  phishingReports   PhishingReport[]
  scoreSnapshots    SecurityScoreSnapshot[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([status])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  status         MembershipStatus @default(ACTIVE)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId, status])
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  isActive      Boolean        @default(true)
  organizations Organization[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  organizationId String?
  action         AuditAction
  resource       String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId])
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  provider       String
  status         IntegrationStatus @default(NOT_CONFIGURED)
  displayName    String
  metadata       Json?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

model Asset {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  type              AssetType
  marcaModelo       String?
  numeroSerie       String?
  sistemaOperativo  String?
  ip                String?
  criticality       Criticality  @default(MEDIUM)
  status            AssetStatus  @default(ACTIVE)
  owner             String?
  location          String?
  description       String?
  protecaoEndpoint  Boolean      @default(false)
  ultimaAtualizacao DateTime?
  mfaAplicavel      Boolean      @default(false)
  cifragem          Boolean      @default(false)
  archivedAt        DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks             Risk[]
  tickets           Ticket[]
  incidents         Incident[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, criticality])
  @@index([organizationId, archivedAt])
}

model RiskAssessment {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  description    String?
  domain         String?
  ownerId        String?
  owner          User?            @relation("AssessmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  startDate      DateTime         @default(now())
  endDate        DateTime?
  status         AssessmentStatus @default(RASCUNHO)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks          Risk[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status])
}

model Risk {
  id             String          @id @default(cuid())
  organizationId String
  assessmentId   String?
  assessment     RiskAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  assetId        String?
  asset          Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  threat         String?
  vulnerability  String?
  probability    Int             @default(3)
  impact         Int             @default(3)
  level          Int             @default(9)
  riskLevel      RiskLevel       @default(MEDIO)
  treatment      String?
  ownerId        String?
  owner          User?           @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  status         RiskStatus      @default(ABERTO)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          RiskTreatmentTask[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, riskLevel])
  @@index([assessmentId])
}

model RiskTreatmentTask {
  id             String              @id @default(cuid())
  organizationId String
  riskId         String
  risk           Risk                @relation(fields: [riskId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assigneeId     String?
  assignee       User?               @relation("TreatmentTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority       Priority            @default(MEDIUM)
  status         TreatmentTaskStatus @default(NAO_INICIADA)
  dueDate        DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments       TaskComment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([riskId])
}

model TaskComment {
  id        String            @id @default(cuid())
  taskId    String
  task      RiskTreatmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime          @default(now())

  @@index([taskId, createdAt])
}

model BackupJob {
  id                     String              @id @default(cuid())
  organizationId         String
  sistemaAtivo           String
  fornecedor             String?
  frequencia             BackupFrequency     @default(DIARIA)
  ultimaExecucao         DateTime?
  estado                 BackupJobStatus     @default(DESCONHECIDO)
  tamanhoGB              Float?
  localizacao            String?
  retencaoDias           Int?
  rtoHoras               Int?
  rpoHoras               Int?
  ultimoTesteRestauracao DateTime?
  notas                  String?
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifications          BackupVerification[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([organizationId, estado])
}

model BackupVerification {
  id          String             @id @default(cuid())
  backupJobId String
  backupJob   BackupJob          @relation(fields: [backupJobId], references: [id], onDelete: Cascade)
  dataTeste   DateTime           @default(now())
  resultado   VerificationResult
  detalhes    String?
  createdAt   DateTime           @default(now())

  @@index([backupJobId, dataTeste])
}

model Ticket {
  id               String         @id @default(cuid())
  organizationId   String
  title            String
  description      String?
  category         TicketCategory @default(SUPORTE)
  status           TicketStatus   @default(ABERTO)
  priority         Priority       @default(MEDIUM)
  slaHoras         Int?
  createdById      String?
  createdBy        User?          @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assigneeId       String?
  assignee         User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assetId          String?
  asset            Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  incidentId       String?
  incident         Incident?      @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  phishingReportId String?
  phishingReport   PhishingReport? @relation(fields: [phishingReportId], references: [id], onDelete: SetNull)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments         TicketComment[]
  events           TicketEvent[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, assigneeId])
  @@index([assetId])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  conteudo  String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tipo      TicketEventType
  descricao String
  autorId   String?
  autor     User?           @relation(fields: [autorId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([ticketId, createdAt])
}

model Incident {
  id               String          @id @default(cuid())
  organizationId   String
  title            String
  description      String?
  type             IncidentType    @default(OUTRO)
  severity         IncidentSeverity @default(MEDIUM)
  status           IncidentStatus  @default(REPORTADO)
  detectedAt       DateTime        @default(now())
  resolvedAt       DateTime?
  sistemasAfetados String?
  acoesImediatas   String?
  licoesAprendidas String?
  responsavelId    String?
  responsavel      User?           @relation("IncidentResponsible", fields: [responsavelId], references: [id], onDelete: SetNull)
  assetId          String?
  asset            Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  phishingReportId String?
  phishingReport   PhishingReport? @relation(fields: [phishingReportId], references: [id], onDelete: SetNull)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timeline         IncidentTimelineEvent[]
  tickets          Ticket[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([assetId])
}

model IncidentTimelineEvent {
  id         String            @id @default(cuid())
  incidentId String
  incident   Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  tipo       IncidentEventType
  descricao  String
  autorId    String?
  autor      User?             @relation(fields: [autorId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([incidentId, createdAt])
}

model SecurityScoreSnapshot {
  id             String        @id @default(cuid())
  organizationId String
  score          Int
  categoria      ScoreCategory
  detalhesJson   Json
  dataReferencia DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId, dataReferencia])
}

model PhishingReport {
  id                    String                @id @default(cuid())
  organizationId        String
  canal                 PhishingChannel       @default(EMAIL)
  remetente             String
  assunto               String?
  descricao             String
  urlSuspeita           String?
  classificacaoInicial  PhishingClassification @default(MEDIA)
  reportanteId          String?
  reportante            User?                 @relation(fields: [reportanteId], references: [id], onDelete: SetNull)
  estado                PhishingReportStatus  @default(NOVO)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets               Ticket[]
  incidents             Incident[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([organizationId, estado])
}

model PhishingCampaign {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  status         PhishingCampaignStatus @default(DRAFT)
  targetCount    Int                   @default(0)
  sentCount      Int                   @default(0)
  clickedCount   Int                   @default(0)
  reportedCount  Int                   @default(0)
  launchedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, status])
}
