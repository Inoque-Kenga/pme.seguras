generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ANALISTA_SEGURANCA
  GESTOR_CLIENTE
  COLABORADOR
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationSize {
  MICRO
  PEQUENA
  MEDIA
  GRANDE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  ASSIGN
  STATUS_CHANGE
}

enum IntegrationStatus {
  NOT_CONFIGURED
  DEMO
  ACTIVE
  ERROR
  DISABLED
}

enum AssetType {
  HARDWARE
  SOFTWARE
  DATA
  SERVICE
  NETWORK
  PEOPLE
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  LOST
  RETIRED
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssessmentStatus {
  RASCUNHO
  EM_ANDAMENTO
  CONCLUIDA
}

enum RiskLevel {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

enum RiskStatus {
  ABERTO
  EM_TRATAMENTO
  ACEITE
  MITIGADO
  FECHADO
}

enum TreatmentTaskStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BackupStatus {
  SUCCESS
  FAILED
  RUNNING
  OVERDUE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

enum TicketCategory {
  INCIDENT
  REQUEST
  VULNERABILITY
  CHANGE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DETECTED
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum PhishingCampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

model User {
  id                     String                   @id @default(cuid())
  name                   String
  email                  String                   @unique
  passwordHash           String
  emailVerified          DateTime?
  isActive               Boolean                  @default(true)
  memberships            OrganizationMembership[]
  auditLogs              AuditLog[]               @relation("AuditActor")
  assessmentsOwned       RiskAssessment[]         @relation("AssessmentOwner")
  risksOwned             Risk[]                   @relation("RiskOwner")
  treatmentTasksAssigned RiskTreatmentTask[]      @relation("TreatmentTaskAssignee")
  taskComments           TaskComment[]
  ticketsCreated         Ticket[]                 @relation("TicketCreator")
  ticketsAssigned        Ticket[]                 @relation("TicketAssignee")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([isActive])
}

model Organization {
  id                String                   @id @default(cuid())
  name              String
  slug              String                   @unique
  nif               String?
  sector            String?
  dimensao          OrganizationSize?
  city              String?
  provincia         String?
  contactoNome      String?
  contactoEmail     String?
  contactoTelefone  String?
  planoId           String?
  plano             SubscriptionPlan?        @relation(fields: [planoId], references: [id], onDelete: SetNull)
  status            OrganizationStatus       @default(ACTIVE)
  memberships       OrganizationMembership[]
  auditLogs         AuditLog[]
  integrations      Integration[]
  assets            Asset[]
  riskAssessments   RiskAssessment[]
  risks             Risk[]
  treatmentTasks    RiskTreatmentTask[]
  backupRecords     BackupRecord[]
  tickets           Ticket[]
  incidents         Incident[]
  phishingCampaigns PhishingCampaign[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([status])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  status         MembershipStatus @default(ACTIVE)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId, status])
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  isActive      Boolean        @default(true)
  organizations Organization[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  organizationId String?
  action         AuditAction
  resource       String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId])
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  provider       String
  status         IntegrationStatus @default(NOT_CONFIGURED)
  displayName    String
  metadata       Json?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

model Asset {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  type              AssetType
  marcaModelo       String?
  numeroSerie       String?
  sistemaOperativo  String?
  ip                String?
  criticality       Criticality  @default(MEDIUM)
  status            AssetStatus  @default(ACTIVE)
  owner             String?
  location          String?
  description       String?
  protecaoEndpoint  Boolean      @default(false)
  ultimaAtualizacao DateTime?
  mfaAplicavel      Boolean      @default(false)
  cifragem          Boolean      @default(false)
  archivedAt        DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks             Risk[]
  tickets           Ticket[]
  incidents         Incident[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, criticality])
  @@index([organizationId, archivedAt])
}

model RiskAssessment {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  description    String?
  domain         String?
  ownerId        String?
  owner          User?            @relation("AssessmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  startDate      DateTime         @default(now())
  endDate        DateTime?
  status         AssessmentStatus @default(RASCUNHO)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks          Risk[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status])
}

model Risk {
  id             String          @id @default(cuid())
  organizationId String
  assessmentId   String?
  assessment     RiskAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  assetId        String?
  asset          Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  threat         String?
  vulnerability  String?
  probability    Int             @default(3)
  impact         Int             @default(3)
  level          Int             @default(9)
  riskLevel      RiskLevel       @default(MEDIO)
  treatment      String?
  ownerId        String?
  owner          User?           @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  status         RiskStatus      @default(ABERTO)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          RiskTreatmentTask[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, riskLevel])
  @@index([assessmentId])
}

model RiskTreatmentTask {
  id             String              @id @default(cuid())
  organizationId String
  riskId         String
  risk           Risk                @relation(fields: [riskId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assigneeId     String?
  assignee       User?               @relation("TreatmentTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority       Priority            @default(MEDIUM)
  status         TreatmentTaskStatus @default(NAO_INICIADA)
  dueDate        DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments       TaskComment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([riskId])
}

model TaskComment {
  id        String            @id @default(cuid())
  taskId    String
  task      RiskTreatmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime          @default(now())

  @@index([taskId, createdAt])
}

model BackupRecord {
  id             String       @id @default(cuid())
  organizationId String
  resource       String
  frequency      String
  status         BackupStatus @default(SUCCESS)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  description    String?
  category       TicketCategory @default(REQUEST)
  status         TicketStatus   @default(OPEN)
  priority       Priority       @default(MEDIUM)
  createdById    String?
  createdBy      User?          @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assetId        String?
  asset          Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([assetId])
}

model Incident {
  id             String          @id @default(cuid())
  organizationId String
  title          String
  description    String?
  severity       IncidentSeverity @default(MEDIUM)
  status         IncidentStatus  @default(DETECTED)
  detectedAt     DateTime        @default(now())
  resolvedAt     DateTime?
  assetId        String?
  asset          Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([assetId])
}

model PhishingCampaign {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  status         PhishingCampaignStatus @default(DRAFT)
  targetCount    Int                   @default(0)
  sentCount      Int                   @default(0)
  clickedCount   Int                   @default(0)
  reportedCount  Int                   @default(0)
  launchedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, status])
}
